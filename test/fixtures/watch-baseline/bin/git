#!/bin/sh
# watch.sh 用の偽 git。
# **前置きの option を全部剥がしてから subcommand で分岐する** —— `-C <path>` / `--no-pager` /
# `-c <key=value>` は呼び出し側の都合で増減するので、位置で決め打ちすると増えた瞬間に壊れる。
set -eu

while [ $# -gt 0 ]; do
  case "$1" in
    -C) shift 2 ;;
    -c) shift 2 ;;
    --no-pager) shift ;;
    *) break ;;
  esac
done

case "${1:-} ${2:-} ${3:-}" in
  "fetch origin --prune")
    ;;
  "rev-parse origin/main "*|"rev-parse origin/main")
    echo "1111111111111111111111111111111111111111"
    ;;
  "rev-parse --verify --quiet")
    echo "1111111111111111111111111111111111111111"
    ;;
  "rev-parse HEAD "*|"rev-parse HEAD")
    echo "2222222222222222222222222222222222222222"
    ;;
  "config --local -z")
    printf 'https://github.com/o/r.git\0'
    ;;
  "config --local --get")
    echo "https://github.com/o/r.git"
    ;;
  "symbolic-ref --quiet HEAD")
    echo "refs/heads/main"
    ;;
  "rev-list --count "*)
    echo "0"
    ;;
  "for-each-ref --format="*)
    # `--format=<面> %(refname:short) %(objectname)` を展開したもの
    printf '%s main 2222222222222222222222222222222222222222\n' "$(printf '%s' "$2" | sed 's/^--format=//; s/ .*//')"
    ;;
  "branch -r "*|"branch -r")
    echo "  origin/main"
    ;;
  "worktree list "*|"worktree list")
    printf 'worktree /fake/wt\nHEAD 2222222222222222222222222222222222222222\nbranch refs/heads/main\n\n'
    ;;
  "status --porcelain=v1 "*|"status --porcelain=v1")
    # clean
    ;;
  *)
    echo "fake git: unexpected args: $*" >&2
    exit 1
    ;;
esac
