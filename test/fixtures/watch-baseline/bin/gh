#!/bin/sh
# watch.sh 用の偽 gh。graphql は watch.sh が自前で jq に通す。
# issues / comments は JSON を返す（指紋への写しは watch.sh 側）。
set -eu

case "$1 ${2:-}" in
  "api graphql")
    cat <<'JSON'
{"data":{"rateLimit":{"cost":2},"organization":{"projectV2":{"items":{"nodes":[
  {"content":{"number":1},"fieldValueByName":{"name":"In progress"}}
]}}}}}
JSON
    ;;
  "api repos/"*"/issues/comments?"*)
    cat <<'JSON'
[{"id":100,"updated_at":"2000-01-01T00:00:00Z","issue_url":"https://api.github.com/repos/o/r/issues/1","body":"<!-- plan -->\n"}]
JSON
    ;;
  "api repos/"*"/issues?"*)
    cat <<'JSON'
[{"number":1,"state":"open","body":"","updated_at":"2000-01-01T00:00:00Z","assignees":[{"login":"tester"}]}]
JSON
    ;;
  "pr list")
    # open PR 0 件は正当。行を出さない
    ;;
  *)
    echo "fake gh: unexpected args: $*" >&2
    exit 1
    ;;
esac
