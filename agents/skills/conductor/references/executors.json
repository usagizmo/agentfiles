{
  // 工程ごとの実行器。全 project 共通で、project 差分 skill には置かない。
  // args は `herdr agent start <名前> --kind <kind> --pane <id> --` 以降。
  // 空配列なら `--` を付けない（その kind の harness 既定）。
  //
  // grok / grok-4.6 high:
  //   "kind": "grok",
  //   "args": ["--model", "grok-4.6", "--effort", "high"]
  //
  // cursor（実行ファイルは cursor-agent。kind は cursor）/ grok-4.6 high:
  //   "kind": "cursor",
  //   "args": ["--model", "cursor-grok-4.6-high"]
  //
  // claude / opus 5 high:
  //   "kind": "claude",
  //   "args": ["--model", "claude-opus-5", "--effort", "high"]
  //
  // codex / gpt-5.6 high:
  //   "kind": "codex",
  //   "args": ["--model", "gpt-5.6", "-c", "model_reasoning_effort=high"]
  "refine": {
    "kind": "cursor",
    "args": ["--model", "cursor-grok-4.6-high"]
  },
  "resolve": {
    "kind": "grok",
    "args": ["--model", "grok-4.6", "--effort", "high"]
  }
}
