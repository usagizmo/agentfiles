[
  // args は `herdr agent start <名前> --kind <kind> --pane <id> --` 以降。
  // 空配列ならその kind の harness 既定。
  // read-only 手段はスクリプトが末尾に足す。
  //
  // grok / grok-4.6 high:
  //   "kind": "grok",
  //   "args": ["--model", "grok-4.6", "--effort", "high"]
  //
  // cursor（実行ファイルは cursor-agent。kind は cursor）/ grok-4.6 high:
  //   "kind": "cursor",
  //   "args": ["--model", "grok-4.6[effort=high]"]
  //
  // claude / opus 5 high:
  //   "kind": "claude",
  //   "args": ["--model", "claude-opus-5", "--effort", "high"]
  //
  // codex / gpt-5.6 high:
  //   "kind": "codex",
  //   "args": ["--model", "gpt-5.6", "-c", "model_reasoning_effort=high"]
  { "kind": "claude", "args": [] },
  { "kind": "codex", "args": [] },
  {
    "kind": "grok",
    "args": ["--model", "grok-4.6", "--effort", "high"],
    "members": ["grok", "cursor"]
    // cursor を起こすときは kind と args を差し替える。members は変えない。
    // "kind": "cursor",
    // "args": ["--model", "grok-4.6[effort=high]"]
  }
]
