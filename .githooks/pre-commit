#!/bin/bash
# commit gate: staged なファイルに oxfmt / oxlint をかけ、整形結果を stage へ戻してから test を回す。
# **対象と実行内容の SSOT は package.json の `lint-staged`。**ここには書かない。
# 配線（core.hooksPath）は ./init.sh、配線の検査は ./doctor.sh。
#
# lint-staged は未 stage 変更を stash して worktree を index に合わせる（失敗時は自動で復元）。
# **設定ファイルは worktree 側が読まれる。**`.oxfmtrc.json` / `package.json` を未 stage で
# 持ったまま commit すると、commit されていない設定で整形される。設定は設定ごと stage する。

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

# GUI クライアント（Sublime Merge / エディタの git UI）から呼ばれると
# `mise activate` 済みの PATH を継承しないので、shims を自分で足す
[ -d "$HOME/.local/share/mise/shims" ] && PATH="$PATH:$HOME/.local/share/mise/shims"

# **bunx ではなく bun run。**bunx は node_modules に無ければ registry から引いてくるので、
# lockfile と無関係な版が黙って gate を通る。bun run は node_modules/.bin までしか見ない。
# **足りないときの診断はここに書かない** — 起動に失敗して commit は止まるし、
# 何が足りないかは ./doctor.sh が言う（揃えるのは ./init.sh）
bun run lint-staged || exit 1

# **テストは対象を絞らない。**「この実装を変えたらこの test」の対応を lint-staged の
# glob で持つと、対応を書き忘れた変更が黙って通る。全体でも数百 ms なので常に回す
bun test
