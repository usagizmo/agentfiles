#!/bin/bash
# commit gate: staged なファイルに oxfmt / oxlint をかけ、整形結果を stage へ戻す。
# **対象と実行内容の SSOT は package.json の `lint-staged`。**ここには書かない。
# 配線（core.hooksPath）は ./init.sh、配線の検査は ./doctor.sh。
#
# lint-staged は未 stage 変更を stash して worktree を index に合わせる。失敗時は
# 自動で復元するが、**gate の実行中に別プロセスから worktree を触らない**こと。

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

# GUI クライアント（Sublime Merge / エディタの git UI）から呼ばれると
# `mise activate` 済みの PATH を継承しないので、shims を自分で足す
[ -d "$HOME/.local/share/mise/shims" ] && PATH="$PATH:$HOME/.local/share/mise/shims"

if ! command -v bun >/dev/null 2>&1; then
  echo "❌ bun がありません（./init.sh）" >&2
  exit 1
fi

if [ ! -d node_modules ]; then
  echo "❌ 開発依存が入っていません（./init.sh か bun install）" >&2
  exit 1
fi

exec bunx lint-staged
